# Cognee settings for the head-to-head; up.sh sources this and sets
# LLM_ENDPOINT and LLM_API_KEY from H2H_CHAT_BASE / H2H_CHAT_KEY.
export LLM_PROVIDER=openai LLM_MODEL=openai/claude-haiku-5-5 LLM_INSTRUCTOR_MODE=json_schema_mode
export EMBEDDING_PROVIDER=ollama EMBEDDING_MODEL=bge-m3 EMBEDDING_ENDPOINT=http://127.0.0.1:11434/api/embed EMBEDDING_DIMENSIONS=1024 HUGGINGFACE_TOKENIZER=BAAI/bge-m3
export TELEMETRY_DISABLED=1 ENV=local
